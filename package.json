{
	"name": "click-to-chat-files",
	"version": "1.3.0",
	"description": "Files / third-party tools addon for Click to Chat. Shipped assets under tools/ are vendored (committed) - jsDelivr serves them from git tags. npm is only the provenance for deliberate, manual syncs into tools/intl-2/.",
	"private": true,
	"type": "module",
	"scripts": {
		"intl:sync": "node dev/scripts/sync-intl.mjs",
		"build:js": "node dev/scripts/build-js.mjs",
		"build:css": "node dev/scripts/build-scoped-css.mjs",
		"build": "npm run build:js && npm run build:css",
		"verify": "node dev/scripts/verify.mjs",
		"check:cdn": "node dev/scripts/check-cdn.mjs",
		"todo:scan": "node dev/scripts/todo-scan.mjs",
		"version:bump": "node dev/scripts/version-bump.mjs",
		"bundle": "chmod +x ./dev/scripts/bundle.sh && ./dev/scripts/bundle.sh",
		"bundle:w": "bash -lc \"chmod +x ./dev/scripts/bundle.sh && bash ./dev/scripts/bundle.sh\"",
		"bundle:verify": "bash dev/scripts/bundle-verify.sh"
	},
	"devDependencies": {
		"intl-tel-input": "29.1.2",
		"postcss": "8.5.15",
		"terser": "5.43.1"
	}
}
